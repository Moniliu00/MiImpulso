<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:padding="12dp"
    android:background="@drawable/fondo_objetivo">


    <!-- permite marcar las tareas como completados-->

    <CheckBox
        android:id="@+id/checkCompletado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/txtTituloObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del objetivo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/impulso_verde" />

        <TextView
            android:id="@+id/txtResunmenObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del objetivo"
            android:textSize="16sp"
            android:textColor="@color/impulso_texto_secundario"
            android:layout_marginTop="4dp"/>


    </LinearLayout>

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_flecha"
        android:tint="@color/impulso_texto_estudios"
        android:background="@drawable/fondo_icono"
        android:backgroundTint="@color/impulso_icono_estudios"
        android:padding="6dp"
        android:contentDescription="Ver estudios"/>




    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_delete"
        android:background="@android:color/transparent"
        android:tint="@color/impulso_proyectos"
        android:contentDescription="Eliminar objetivo"/>

</LinearLayout>