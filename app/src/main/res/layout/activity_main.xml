<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:background="@color/impulso_fondo">

    <TextView
        android:id="@+id/txtFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Miercoles, 4 de noviembre"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/impulso_verde"
        android:gravity="start"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MI IMPULSO"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/impulso_verde"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organiza tus metas, avanza a tu ritmo"
        android:textSize="16sp"
        android:textColor="@color/impulso_texto"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtSaludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hola"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/impulso_verde"
        android:gravity="start"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/impulso_borde_tarjeta"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/fondo_impulso_anterior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_impulso"
                    android:tint="@color/impulso_verde"
                    android:contentDescription="Inspiración"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="TU IMPULSO DE HOY"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/impulso_verde" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtFrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando tu frase del día..."
                android:textSize="15sp"
                android:textColor="@color/impulso_verde"
                android:gravity="start" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

   <LinearLayout
       android:id="@+id/btnEstudios"
       style="@style/TarjetaInicio"
       android:backgroundTint="@color/impulso_estudios">

       <ImageView
           android:layout_width="56dp"
           android:layout_height="56dp"
           android:src="@drawable/ic_estudios"
           android:contentDescription="Estudios"
           android:padding="16dp"
           android:background="@drawable/fondo_icono"
           android:tint="@color/impulso_texto"
           android:backgroundTint="@color/impulso_icono_estudios"/>

       <LinearLayout
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:orientation="vertical"
           android:layout_marginStart="12dp">

           <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="Mis estudios"
               android:textSize="20dp"
               android:textStyle="bold"
               android:textColor="@color/impulso_texto_estudios"/>

           <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="4dp"
               android:text="Temario, repasos, objetivos..."
               android:textColor="@color/impulso_texto_estudios"/>
       </LinearLayout>

       <ImageView
           android:layout_width="32dp"
           android:layout_height="32dp"
           android:src="@drawable/ic_flecha"
           android:tint="@color/impulso_texto_estudios"
           android:background="@drawable/fondo_icono"
           android:backgroundTint="@color/impulso_icono_estudios"
           android:padding="6dp"
           android:contentDescription="Ver estudios"/>

   </LinearLayout>

   <LinearLayout
       android:id="@+id/btnProyectos"
       style="@style/TarjetaInicio"
       android:backgroundTint="@color/impulso_proyectos">

       <ImageView
           android:layout_width="56dp"
           android:layout_height="56dp"
           android:src="@drawable/ic_proyectos"
           android:background="@drawable/fondo_icono"
           android:backgroundTint="@color/impulso_icono_proyectos"
           android:tint="@color/impulso_texto_proyectos"
           android:padding="14dp"
           android:contentDescription="Proyectos"/>

       <LinearLayout
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:layout_marginStart="12dp"
           android:orientation="vertical">

           <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="Mis Proyectos"
               android:textSize="20sp"
               android:textStyle="bold"
               android:textColor="@color/impulso_texto_proyectos"/>

           <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="4dp"
               android:text="Trabajo, ideas, creatividad..."
               android:textSize="13sp"
               android:textColor="@color/impulso_texto_proyectos"/>

       </LinearLayout>

       <ImageView
           android:layout_width="32dp"
           android:layout_height="32dp"
           android:src="@drawable/ic_flecha"
           android:tint="@color/impulso_texto_proyectos"
           android:background="@drawable/fondo_icono"
           android:backgroundTint="@color/impulso_icono_proyectos"
           android:padding="6dp"
           android:contentDescription="Ver estudios"/>

   </LinearLayout>


    <LinearLayout
        android:id="@+id/btnPersonal"
        style="@style/TarjetaInicio"
        android:backgroundTint="@color/impulso_personal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_personal"
            android:background="@drawable/fondo_icono"
            android:backgroundTint="@color/impulso_icono_personal"
            android:tint="@color/impulso_texto_personal"
            android:padding="14dp"
            android:contentDescription="Objetivos personales"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis objetivos personales"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/impulso_texto_personal"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hábitos, bienestar, salud..."
                android:textSize="13sp"
                android:textColor="@color/impulso_texto_personal"/>

        </LinearLayout>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_flecha"
            android:tint="@color/impulso_texto_personal"
            android:background="@drawable/fondo_icono"
            android:backgroundTint="@color/impulso_icono_personal"
            android:padding="6dp"
            android:contentDescription="Ver estudios"/>

    </LinearLayout>







</LinearLayout>