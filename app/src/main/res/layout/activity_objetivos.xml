<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/impulso_fondo">

    <TextView
        android:id="@+id/txtCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis objetivos"
        android:textSize="28dp"
        android:textColor="@color/impulso_verde"
        android:gravity="center"/>

   <!-- mostrara la lista de tareas -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerObjetivos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:padding="8dp"/>

    <Button
        android:id="@+id/btnNuevoObjetivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Nuevo objetivo"
        android:textColor="@color/impulso_blanco"
        android:backgroundTint="@color/impulso_estudios"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al inicio"
        android:textColor="@color/impulso_blanco"
        android:backgroundTint="@color/impulso_verde"
        android:layout_marginTop="24dp"/>

</LinearLayout>