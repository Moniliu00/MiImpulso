<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/impulso_fondo">

    <TextView
        android:id="@+id/txtCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis objetivos"
        android:textSize="28dp"
        android:textColor="@color/impulso_verde"
        android:gravity="center"/>

   <!-- mostrara la lista de tareas -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerObjetivos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:padding="8dp"/>

    <Button
        android:id="@+id/btnNuevoObjetivo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textAllCaps="false"
        android:textSize="16dp"
        android:textStyle="bold"
        android:text="+ Nuevo objetivo"
        android:textColor="@color/impulso_blanco"
        android:backgroundTint="@color/impulso_estudios"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textAllCaps="false"
        android:textSize="16dp"
        android:textStyle="bold"
        android:text="Volver al inicio"
        android:textColor="@color/impulso_texto_estudios"
        android:backgroundTint="@color/impulso_icono_estudios"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:icon="@drawable/ic_home"
        app:iconTint="@color/impulso_texto_estudios"
        app:iconPadding="8dp"
        app:iconGravity="textStart"/>

</LinearLayout>