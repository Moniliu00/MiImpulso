<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/impulso_fondo">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >


        <LinearLayout
            android:id="@+id/fondoEncabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:background="@color/impulso_icono_estudios">

            <TextView
                android:id="@+id/txtMiImpulso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mi Impulso"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/impulso_verde"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>

            <TextView
                android:id="@+id/txtEncabezadoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalle del objetivo"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/impulso_verde"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/impulso_blanco">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/txtDetalleTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre del objetivo"
                    android:textSize="22sp"
                    android:textColor="@color/impulso_verde" />

                <ImageView
                    android:id="@+id/btnEditarObjetivo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_editar"
                   android:padding="9dp"
                    android:contentDescription="Editar objetivo"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>


            <TextView
                android:id="@+id/txtDetalleCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estudios"
                android:textSize="18sp"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/txtDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin descripción"
                android:textSize="16sp"
                android:textColor="@color/impulso_verde"
                android:layout_marginTop="24dp"/>


            <TextView
                android:id="@+id/txtDetalleEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:textSize="18sp"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverObjetivos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:text="Volver a mis objetivos"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/impulso_texto_estudios"
        android:backgroundTint="@color/impulso_icono_estudios"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_flecha_left"
        app:iconTint="@color/impulso_texto_estudios"
        app:iconPadding="8dp"
        app:iconGravity="textStart"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



